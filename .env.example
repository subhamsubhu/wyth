# WYTH backend — example environment configuration.
# Copy to .env and fill in the real values. Do NOT commit .env.

NODE_ENV=production
PORT=8001

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Used to re-verify a user's own current password (REST sign-in). Public Web API key.
FIREBASE_API_KEY=your-web-api-key

# Role-based access control safety net.
# Must reference an existing Firebase Auth user. No user/password is ever created.
SUPERADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com

# Strong secrets (64 hex chars / 32 hex chars).
JWT_SECRET=
ENCRYPTION_KEY=

# Strict CORS allow-list (no wildcards in production).
CORS_ORIGIN=https://your-frontend-domain.com

# Optional integrations
YOUTUBE_API_KEY=

# ─── REMOVED / DEPRECATED — do NOT re-add ───
# ADMIN_EMAILS=         # replaced by Firestore users/{uid}.role + custom claims
# SEED_ADMIN_EMAIL=     # removed: no hardcoded admin login
# SEED_ADMIN_PASSWORD=  # removed: no hardcoded admin password
# SEED_ADMIN_NAME=      # removed
